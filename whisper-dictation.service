[Unit]
Description=Whisper Dictation (push-to-talk)
Wants=lmstudio-server.service
After=lmstudio-server.service

[Service]
# The service starts from default.target, before i3/X11 reliably exports
# DISPLAY into the user systemd manager. xclip/xdotool need these to paste.
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
EnvironmentFile=%h/.config/whisper-dictation/env
ExecStart=/bin/bash -lc 'exec "$HOME/.local/bin/dictation" $DICTATION_ARGS'
Restart=always
RestartSec=3
SyslogIdentifier=whisper-dictation

[Install]
WantedBy=default.target
